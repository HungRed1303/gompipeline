# ============================================================
# GOM Pipeline — copy file này thành .env và điền thông tin
# ============================================================

# Google Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot
# 1. Nhắn @BotFather trên Telegram → /newbot để lấy token
# 2. Nhắn @userinfobot hoặc thêm bot vào nhóm để lấy CHAT_ID
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# PostgreSQL — thay đổi user/password/dbname theo cài đặt của bạn
DATABASE_URL=postgresql+asyncpg://gom:gom123@localhost:5432/gom_pipeline

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
